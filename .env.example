# Flask Configuration
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Settings
PORT=5000

# Database Configuration (leave blank for local SQLite default)
DEV_DATABASE_URL=sqlite:///dev_blog.db
# DATABASE_URL=postgresql://username:password@localhost:5432/chronicle_db

# Pagination Settings
POSTS_PER_PAGE=6
COMMENTS_PER_PAGE=10
